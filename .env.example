# Server-only Supabase access. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Deposit amount in paise (100000 = INR 1,000)
BOOKING_DEPOSIT_PAISE=100000

# Confirmation email via Resend
RESEND_API_KEY=re_replace_me
BOOKING_FROM_EMAIL=Ahmedabad Ink <bookings@your-domain.com>
STUDIO_EMAIL=hello@your-domain.com

# Consent-controlled analytics and usability insights
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_PROJECT_ID=replace-with-clarity-project-id

# Optional WhatsApp Cloud API confirmation template
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_TEMPLATE_NAME=booking_confirmation
