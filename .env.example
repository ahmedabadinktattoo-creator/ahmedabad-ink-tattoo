# Server-only Supabase access. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Deposit amount in paise (100000 = INR 1,000)
BOOKING_DEPOSIT_PAISE=100000

# Confirmation email via Resend
RESEND_API_KEY=re_replace_me
BOOKING_FROM_EMAIL=Ahmedabad Ink <bookings@your-domain.com>
STUDIO_EMAIL=hello@your-domain.com

# Consent-controlled analytics and usability insights
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-6G8K7KQH0J
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-WKQTS5QF
NEXT_PUBLIC_META_PIXEL_ID=1341779253037735
NEXT_PUBLIC_CLARITY_PROJECT_ID=replace-with-clarity-project-id

# Server-side marketing integrations. Keep every secret server-only.
MARKETING_CRM_WEBHOOK_URL=https://script.google.com/macros/s/replace-me/exec
MARKETING_CRM_WEBHOOK_SECRET=replace-with-a-long-random-secret
META_PIXEL_ID=1341779253037735
META_CAPI_ACCESS_TOKEN=replace-with-meta-events-manager-token
META_GRAPH_API_VERSION=v25.0
# Set only while validating in Meta Test Events; remove after testing.
META_TEST_EVENT_CODE=

# Optional WhatsApp Cloud API confirmation template
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_TEMPLATE_NAME=booking_confirmation
